# marmel.toml.example — copy to ./.marmel.toml or ~/.config/marmel/config.toml

# Base URL of the OpenAI-compatible chat completions backend (no trailing slash).
backend_url = "http://localhost:8000/v1"

# Optional bearer token sent as `Authorization: Bearer <token>`.
auth_token = ""

# Model identifier to send in the chat request.
model = "qwen-3.8-27b"

# Sampling parameters.
temperature = 0.7
top_p = 0.9
frequency_penalty = 0.0
presence_penalty = 0.0

# Token budget for the context window; compaction triggers at 90%.
max_context_tokens = 8192

# Preserve reasoning/thinking content in the transcript when enabled.
preserve_thinking = true

# Maximum reasoning/thinking tokens per turn before cutting off runaway reasoning.
max_thinking_tokens = 32768

# Timeout (seconds) for a single run_command / PTY invocation.
# Valid range 1..=300; an out-of-range value is logged and clamped into that range.
command_timeout_secs = 60

# Set to true to run commands WITHOUT the Linux Landlock sandbox — the default is
# false (fail-closed: commands are sandboxed), and `true` always logs an
# attributable warning. `MARMEL_DISABLE_SANDBOX=1` remains an equivalent escape hatch.
sandbox_disabled = false

# Number of semantically-identical consecutive turns that trigger cycle breaking.
max_repetition_threshold = 5

# Enable XML-rescue fallback when the model emits malformed tool calls.
enable_xml_rescue = true

# UI mode: "tui" (ratatui) or "raw" (plain streaming).
ui_mode = "tui"

# ---------------------------------------------------------------------------
# Session capture / restore (the `.marmel/session/` bundle: manifest.json —
# written LAST, the commit point — plus manager.json, ui.json and
# workers/<key>.json). All six keys are top-level, optional, and shown here at
# their built-in defaults. See docs/session_restore.md.
# ---------------------------------------------------------------------------
#
# Master switch for session capture (bool). Capture-on is the safety property:
# the environment key MARMEL_SESSION_DISABLE is a ONE-WAY switch — `1`/`true`/
# `yes`/`on` turns capture OFF, and no environment value can turn it on over an
# explicit `session_enabled = false` here.
# session_enabled = true
#
# Rehydrate the previous run from the bundle at boot (bool). Default false: a
# fresh start is the normal behaviour. `--resume` on the command line, or
# MARMEL_RESUME with a recognized boolean (`1`/`true`/`yes`/`on`), turns it on
# for one run; `--fresh` always wins and is the escape hatch. A refused restore
# exits 3 (`session::EXIT_RESTORE_REFUSED`) and starts nothing.
# session_resume = false
#
# Floor in milliseconds between throttled commits (integer). A commit trigger
# inside this interval is skipped. `MARMEL_SESSION_COMMIT_MIN_MS=<ms>` overrides
# it for one run; a non-integer value is reported and ignored, never read as 0.
# session_commit_min_interval_ms = 250
#
# Cap on the in-memory per-worker transcript mirror (integer message count).
# Past the cap the oldest completed records are dropped first, and the number of
# drops is reported on restore.
# session_worker_mirror_max_messages = 4000
#
# Commit at every landed tool result (bool). `false` keeps the coarser triggers
# (turn boundary, idle, abort, exit) and drops the per-result ones: fewer writes,
# coarser crash granularity.
# session_commit_on_tool_result = true
#
# Soft ceiling on total bundle member bytes in bytes (integer; 33554432 = 32 MiB).
# Crossing it warns once and stops the throttled triggers; the load-bearing
# commits (exit / abort / panic) still run.
# session_max_bundle_bytes = 33554432

# Monitoring & resilience harness (repetition detection & loop breaking)
[monitoring]
enabled = true
repetition_threshold = 5
min_pattern_len = 7
max_stream_tokens = 32768
max_thinking_tokens = 32768

# ---------------------------------------------------------------------------
# Orchestration — Manager + Specialist Subagents (REQ-ORCH-001…005 / SPEC Part 5)
# ---------------------------------------------------------------------------
# The Manager (OrchestratorManager) owns planning, delegation, and synthesis. It
# NEVER performs domain work itself: every unit of domain work is dispatched via
# `delegate_task`.
#
# Each specialist can optionally configure a unique backend_url and auth_token
# (e.g. routing code generation to a local GPU while delegating validation or
# generalist tasks to remote cloud models). Unspecified fields fall back to the
# top-level backend_url and auth_token.
[orchestration]
# Fractal delegation depth bound. The Manager is depth 0; each nested
# `delegate_task` may descend at most this many levels (default 3).
max_recursion_depth = 3

# Per-specialist tool allowlists, backend endpoints, and model configurations.
[orchestration.specialists.coder]
tools = ["delegate_task", "write_file", "replace", "read_file", "run_command", "grep_search", "glob"]
model = "deepseek-v4-flash:cloud"
# Optional unique backend and token for coder:
# backend_url = "http://localhost:11434/v1"
# auth_token = ""
# Optional: set false to disable automated quality-assurance validation
# enable_validator = false
# Optional unique validator settings for coder's quality assurance:
validator_model = "gemma4:cloud"
# validator_backend_url = "http://localhost:11434/v1"
# validator_auth_token = ""
max_validator_iterations = 5
# Optional: maximum fix-loop rounds per validation pass (default: 200)
# max_fix_loop_rounds = 200
# Optional reasoning budget / max thinking tokens override for this specialist:
# max_thinking_tokens = 8192

[orchestration.specialists.debugger]
tools = ["delegate_task", "write_file", "replace", "read_file", "run_command", "grep_search", "glob", "pty_spawn", "pty_write", "pty_read", "pty_close", "pty_list"]
model = "deepseek-v4-flash:cloud"
# backend_url = "http://localhost:11434/v1"
# enable_validator = false
validator_model = "gemma4:cloud"
max_validator_iterations = 5

[orchestration.specialists.researcher]
tools = ["delegate_task", "read_file", "run_command", "grep_search", "glob"]
model = "deepseek-v4-flash:cloud"
validator_model = "gemma4:cloud"
max_validator_iterations = 5

[orchestration.specialists.validator]
tools = ["delegate_task", "write_file", "replace", "read_file", "run_command", "grep_search", "glob"]
model = "gemma4:cloud"
# backend_url = "http://localhost:11434/v1"
# auth_token = ""

[orchestration.specialists.generalist]
tools = ["*"]
model = "deepseek-v4-flash:cloud"
# backend_url = "https://openrouter.ai/api/v1"
# auth_token = "sk-or-..."

# ---------------------------------------------------------------------------
# External MCP servers (Model Context Protocol)
# ---------------------------------------------------------------------------
# Each entry under `[mcp_servers.<name>]` registers an external MCP server that
# marmel can connect to. A server must use exactly ONE transport:
#
#   * stdio  — spawn a local executable via `command` (+ optional `args`).
#   * remote — reach an HTTP/SSE endpoint via `url`.
#
# A server may NOT set both `command` and `url`; pick the transport that matches
# the server you are integrating.
#
# `env` is optional and only applies to stdio servers: it sets environment
# variables for the spawned process (e.g. API keys the server needs).
#
# Discovered MCP tools are exposed to agents with a `<server_name>__<tool_name>`
# prefix (e.g. a tool `read_file` from server `filesystem` appears as
# `filesystem__read_file`). This prefix prevents name collisions when multiple
# servers expose tools with the same name. The prefix is stripped automatically
# before the call is sent to the MCP server, so the server always receives the
# original unprefixed tool name.

# Example 1 — local stdio server (spawns `npx`).
[mcp_servers.filesystem]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
# env = { SOME_API_KEY = "..." }

# Example 2 — remote/external HTTP/SSE server (reached over the network).
[mcp_servers.remote]
url = "https://example.com/mcp"
