# marmel.toml
backend_url = "http://192.168.50.162:8080/v1"
auth_token = ""

# Default model for Manager / Orchestrator (puck:gemma 12B)
model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"

temperature = 0.7
top_p = 0.9
max_context_tokens = 90112
preserve_thinking = true
ui_mode = "tui"

[monitoring]
enabled = true
repetition_threshold = 5
min_pattern_len = 7
max_stream_tokens = 32768

[orchestration]
max_recursion_depth = 3

# Session concurrency — one simultaneous-session cap per (backend_url, model)
# pair. Every role here points at the SAME model on the SAME host, so this one
# number covers Manager turns, specialist turns, and validator passes alike:
# they all queue behind each other, which is the point (the server only serves
# a couple of streams at a time anyway). Two models behind one host would each
# get their own cap — the cap is per URL + model, not per host.
# Unset (omit the table) means UNLIMITED — unlimited parallel streams against
# one gguf model buy queueing and 429s, not throughput. `0` is treated as
# unlimited too, with a warning naming the key. Start local single-model
# backends at 1 or 2.
[orchestration.concurrency]
max_sessions = 2
# Per-URL overrides must be quoted (key = backend_url); trailing slashes in the
# key are ignored:
# "http://192.168.50.162:8080/v1" = 1
# A session waiting for a slot shows as `(Queued n/m)` in the Subagents panel;
# that wait is bounded to 900 s per backend call, separate from the 1200 s
# per-stream read timeout, and a queue timeout fails that delegation with an
# error naming the cap and the pair. The steer arbitrator and the notice
# evaluation use a separate reserve slot and add at most one extra in-flight
# stream per pair.

# Reasoning-effort dials (a dial, not a cap — max_thinking_tokens stays the
# ceiling, and both may be set). Values are free-form pass-through
# ("none", "minimal", "low", "medium", "high"); unset or blank means the key is
# never sent. `reasoning_effort` inside a specialist section dials that role's own
# turns, `validator_reasoning_effort` (next to validator_model) dials its
# validation passes — up to max_validator_iterations = 5 per task, so a low-effort
# validator is the cheapest saving. A top-level `reasoning_effort` (outside
# [orchestration]) would cover the Manager and every role that does not override
# it; it is left unset here so requests go out without the field.

# Coder specialist — Lead Software Engineer (architecture, implementation, testing)
[orchestration.specialists.coder]
tools = ["delegate_task", "write_file", "replace", "read_file", "run_command", "grep_search", "glob"]
model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
validator_model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
validator_reasoning_effort = "low"
max_validator_iterations = 5

# Debugger specialist — Systems Debugger (crash forensics, ABI/low-level diagnostics)
[orchestration.specialists.debugger]
tools = ["delegate_task", "write_file", "replace", "read_file", "run_command", "grep_search", "glob", "pty_spawn", "pty_write", "pty_read", "pty_close", "pty_list"]
model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
validator_model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
validator_reasoning_effort = "low"
max_validator_iterations = 5

# Researcher specialist — Information Retrieval & Ground Truth Fact-Checking
[orchestration.specialists.researcher]
tools = ["delegate_task", "read_file", "run_command", "grep_search", "glob"]
model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
validator_model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
validator_reasoning_effort = "low"
max_validator_iterations = 5

# Validator specialist — Independent Quality Assurance Auditor
[orchestration.specialists.validator]
tools = ["delegate_task", "write_file", "replace", "read_file", "run_command", "grep_search", "glob"]
model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"

# Generalist specialist — Supreme Polymath (dense reasoning & cross-domain analysis)
[orchestration.specialists.generalist]
tools = ["*"]
model = "gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"
